{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "deenislamic",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-25",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deenislamic",
      "database_id": "7c1b9180-4915-4457-ba33-2c1522d93e50"
    }
  ]
}
